# ─── Sanity CMS Configuration ───────────────────────────────────────────────
# Get these from: https://www.sanity.io/manage → your project → Settings → API

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: For live preview / draft mode (generate at sanity.io/manage → Tokens)
# SANITY_API_READ_TOKEN=your_read_token_here

# Webhook Secret (used by /api/revalidate to verify Sanity webhooks)
SANITY_WEBHOOK_SECRET=your_webhook_secret_here

# Canonical domain — used by sitemap.ts and robots.ts (no www, no trailing slash)
NEXT_PUBLIC_SITE_URL=https://afsaracademy.com
